# Copy to testbed/.env on the Pi and fill in. Never commit .env.
# The dashboard's ingest endpoint, for example http://<dashboard host>:8000/api/ingest/
INGEST_URL=http://dashboard-host:8000/api/ingest/
# Must equal INGEST_TOKEN in the dashboard's .env
INGEST_TOKEN=change-me-to-the-dashboard-ingest-token
