# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Token the Raspberry Pi sends to /api/ingest/ (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
INGEST_TOKEN=change-me-to-a-long-random-token

# PostgreSQL / TimescaleDB
DB_NAME=motorsense_db
DB_USER=motorsense_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
