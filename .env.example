# Copy to .env and fill in real values. Never commit .env.
# Every variable the project reads (monitor/settings.py).

# Django secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Token the Raspberry Pi sends to /api/ingest/ as "Authorization: Bearer <token>".
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=change-me-to-a-long-random-token

# PostgreSQL / TimescaleDB. docker-compose.yml creates the database motorsense_db for the user
# motorsense_user with DB_PASSWORD, on port 5432; keep DB_NAME and DB_USER as they are when
# using it.
DB_NAME=motorsense_db
DB_USER=motorsense_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
